{
    "name": "opencck/mercurius-mail-mcp",
    "description": "An MCP server over stdio with its own async IMAP and SMTP client for AMPHP: one mailbox per process; list, read and send mail, sender authentication by Authentication-Results",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "amphp",
        "mcp",
        "imap",
        "smtp",
        "mail",
        "agent"
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "amphp/amp": "^3",
        "amphp/byte-stream": "^2",
        "amphp/socket": "^2",
        "psr/log": "^3"
    },
    "require-dev": {
        "amphp/phpunit-util": "^3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.22.2",
        "vimeo/psalm": "^6"
    },
    "autoload": {
        "psr-4": {
            "Mercurius\\MailMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mercurius\\MailMcp\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/mail-mcp-stdio"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {}
    },
    "scripts": {
        "test": "php -d zend.assertions=1 -d assert.exception=1 vendor/bin/phpunit",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-progress --show-info=false",
        "check": [
            "@test",
            "@phpstan",
            "@psalm"
        ]
    }
}
