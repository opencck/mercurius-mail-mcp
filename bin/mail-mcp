#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The mail MCP server: MAIL_MCP_TOKEN (required), MAIL_MCP_PORT (8090), MAIL_MCP_HOST (0.0.0.0).
 */

use Mercurius\MailMcp\Mailbox;
use Mercurius\MailMcp\McpHandler;
use Mercurius\MailMcp\Server;
use Psr\Log\NullLogger;

use function Amp\trapSignal;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$token = getenv('MAIL_MCP_TOKEN');
if (!is_string($token) || strlen($token) < 16) {
    fwrite(STDERR, "MAIL_MCP_TOKEN is required (16+ characters)\n");
    exit(78);
}
$port = (int) (getenv('MAIL_MCP_PORT') ?: 8090);
$host = (string) (getenv('MAIL_MCP_HOST') ?: '0.0.0.0');
$logger = new NullLogger();
$server = (new Server(new McpHandler(new Mailbox()), $token, $logger))->start($host, max(1, min(65535, $port)));
fwrite(STDERR, sprintf("mail-mcp listening on %s:%d\n", $host, $port));
trapSignal([2, 15]);
$server->stop();
